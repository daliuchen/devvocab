    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
