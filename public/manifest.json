{
  "manifest_version": 3,
  "name": "ReadTrace",
  "description": "Remember where technical words came from.",
  "version": "0.1.6",
  "icons": {
    "16": "icons/readtrace-16.png",
    "32": "icons/readtrace-32.png",
    "48": "icons/readtrace-48.png",
    "128": "icons/readtrace-128.png"
  },
  "permissions": ["contextMenus"],
  "action": {
    "default_title": "ReadTrace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/readtrace-16.png",
      "32": "icons/readtrace-32.png",
      "48": "icons/readtrace-48.png",
      "128": "icons/readtrace-128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
