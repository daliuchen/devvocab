{
  "manifest_version": 3,
  "name": "ReadTrace",
  "description": "Remember where technical words came from.",
  "version": "0.0.1",
  "permissions": ["contextMenus"],
  "action": {
    "default_title": "ReadTrace",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
